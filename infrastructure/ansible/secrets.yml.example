---
# =============================================================================
# ANSIBLE VAULT - Secrets Template
# =============================================================================
# This is a template for secrets.yml
#
# USAGE:
#   1. Copy this file: cp secrets.yml.example secrets.yml
#   2. Edit secrets.yml with your values: ansible-vault edit secrets.yml
#   3. Or create encrypted file: ansible-vault create secrets.yml
#
# ENCRYPTION:
#   - Encrypt: ansible-vault encrypt secrets.yml
#   - Edit: ansible-vault edit secrets.yml
#   - View: ansible-vault view secrets.yml
#   - Decrypt: ansible-vault decrypt secrets.yml
#
# VAULT PASSWORD:
#   - Store in .vault_pass file (not tracked by git)
#   - Or use --ask-vault-pass flag when running playbooks
# =============================================================================

# =============================================================================
# GITHUB CONTAINER REGISTRY (GHCR)
# =============================================================================
# Token for pulling private Docker images from GitHub Container Registry
# Generate: https://github.com/settings/tokens (with read:packages permission)
# Example: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
vault_github_token: "your_ghcr_token_here"

# =============================================================================
# DATABASE SECRETS
# =============================================================================
# PostgreSQL database password for memocards_user
# Use strong password (min 16 characters recommended)
# Example: MySecureDbPassword123!
vault_db_password: "your_secure_db_password_here"

# =============================================================================
# GRAFANA SECRETS
# =============================================================================
# Grafana admin password
# Use strong password (min 12 characters recommended)
# Example: MySecureGrafanaPassword123!
vault_grafana_admin_password: "your_grafana_password_here"

# =============================================================================
# DUCKDNS TOKEN
# =============================================================================
# DuckDNS token for DNS updates and SSL certificate automation
# Get from: https://www.duckdns.org/
# Example: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
vault_duckdns_token: "your_duckdns_token_here"

# =============================================================================
# TRAEFIK DASHBOARD AUTHENTICATION
# =============================================================================
# Traefik dashboard password hash (htpasswd format)
# Generate with:
#   htpasswd -nb admin YOUR_PASSWORD | cut -d: -f2
# Or:
#   echo -n "YOUR_PASSWORD" | openssl passwd -apr1 -stdin
# Example: $apr1$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
vault_traefik_dashboard_password_hash: "your_htpasswd_hash_here"

# =============================================================================
# DEMO DATA SECRETS (Optional - for initial data seeding)
# =============================================================================
# Admin user password for demo data
# Example: admin123
vault_demo_admin_password: "your_demo_admin_password_here"

# Demo user password for demo data
# Example: user123
vault_demo_user_password: "your_demo_user_password_here"

# =============================================================================
# TEST DATA SECRETS (Optional - for test data generation)
# =============================================================================
# Test user password
# Example: testPassword123
vault_test_user_password: "your_test_user_password_here"

# =============================================================================
# NOTES
# =============================================================================
# - All values starting with "vault_" are encrypted by Ansible Vault
# - Never commit secrets.yml to git (use .gitignore)
# - Keep .vault_pass file secure and never commit it
# - Rotate passwords regularly in production environments
# - Use environment-specific secrets for dev/staging/prod
# =============================================================================

