#!/bin/bash
# =============================================================================
# PostgreSQL Backup Verification Script
# =============================================================================
# Usage: verify-backup.sh <backup_file>
# =============================================================================

set -euo pipefail

BACKUP_FILE="${1:-}"
DB_CONTAINER="memocards-postgres-prod"
DB_NAME="{{ db_name }}"
DB_USER="{{ db_user }}"

if [ -z "${BACKUP_FILE}" ] || [ ! -f "${BACKUP_FILE}" ]; then
    echo "ERROR: Backup file not specified or not found: ${BACKUP_FILE}"
    exit 1
fi

# Check if PostgreSQL container is running
if ! docker ps --format '{{.Names}}' | grep -q "^${DB_CONTAINER}$"; then
    echo "ERROR: PostgreSQL container ${DB_CONTAINER} is not running!"
    exit 1
fi

# For custom format backups, use pg_restore --list to verify
# This doesn't restore data, just validates the backup structure
if docker exec "${DB_CONTAINER}" \
    pg_restore --list --file=- "${BACKUP_FILE}" 2>/dev/null | head -n 1 > /dev/null; then
    echo "✅ Backup file is valid (structure verified)"
    exit 0
else
    # Fallback: check if file is not empty and is gzipped
    if [ -s "${BACKUP_FILE}" ] && file "${BACKUP_FILE}" | grep -q "gzip compressed"; then
        echo "⚠️  Backup file exists but structure verification failed (file appears valid)"
        exit 0
    else
        echo "❌ Backup file is invalid or corrupted"
        exit 1
    fi
fi

